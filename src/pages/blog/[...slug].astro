---
import BlogPost from '../../layouts/BlogPost.astro';
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  return blogEntries.map((entry) => {
    const lang = entry.data.lang || 'en';
    const fileName = entry.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || '';
    const filePath = path.join(process.cwd(), 'src', 'content', 'blog', `${entry.id}.md`);
    const fallbackPath = path.join(process.cwd(), 'src', 'content', 'blog', `${entry.id}.mdx`);
    
    let readingTime = 1;
    const fileToRead = fs.existsSync(filePath) ? filePath : fallbackPath;
    
    if (fs.existsSync(fileToRead)) {
      const rawContent = fs.readFileSync(fileToRead, 'utf-8');
      const contentWithoutFrontmatter = rawContent.replace(/^---[\s\S]*?---/, '').trim();
      const wordCount = contentWithoutFrontmatter.split(/\s+/).filter(Boolean).length;
      readingTime = Math.max(1, Math.ceil(wordCount / 200));
    }

    const alternateLang = lang === 'en' ? 'es' : 'en';
    const alternateEntry = blogEntries.find((e) => {
      const eFileName = e.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || '';
      return e.data.lang === alternateLang && eFileName === fileName;
    });

    return {
      params: { slug: entry.id },
      props: { entry, readingTime, lang, alternateEntry },
    };
  });
}

const { entry, readingTime, lang, alternateEntry } = Astro.props;
const { Content } = await render(entry);
---

<BlogPost
  title={entry.data.title}
  description={entry.data.description}
  date={new Date(entry.data.date)}
  tags={entry.data.tags}
  coverImage={entry.data.coverImage}
  readingTime={readingTime}
  lang={lang}
  alternateUrl={alternateEntry ? `/blog/${alternateEntry.id}` : undefined}
>
  <Content />
</BlogPost>